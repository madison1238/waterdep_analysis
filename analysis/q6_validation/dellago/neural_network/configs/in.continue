read_restart chunk.restart

variable temp equal 222

pair_style sw
pair_coeff * * mW.sw mW

neighbor 4.0 bin
neigh_modify every 1 check yes


fix 1 all npt temp ${temp} ${temp} 50 iso 0.986923 0.986923 500

thermo 100
thermo_style custom step temp press pe ke etotal density

dump 1 all custom ${dump_interval} ${dumpfile} id type x y z
run ${nsteps}
write_restart chunk.next.restart


undump 1
unfix 1